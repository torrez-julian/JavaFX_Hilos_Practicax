<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20" prefWidth="600" prefHeight="480"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.practicahilos.ProcesadorController">

    <padding>
        <Insets top="20" right="25" bottom="20" left="25"/>
    </padding>

    <Label text="Monitor de Procesos Concurrentes" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <!-- SECCIÓN DE CLIENTES (100 registros) -->
    <VBox spacing="8" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 12;">
        <Label text="Proceso de Clientes (100 registros)" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
        <Label fx:id="lblEstadoClientes" text="Esperando inicio"/>
        <ProgressBar fx:id="barraClientes" progress="0" prefWidth="520"/>
        <Label fx:id="lblPorcentajeClientes" text="0%"/>
        <HBox alignment="CENTER" spacing="10">
            <Button fx:id="btnIniciarClientes" text="Iniciar Clientes" onAction="#iniciarClientes"/>
            <Button fx:id="btnDetenerClientes" text="Detener" onAction="#detenerClientes" disable="true"/>
            <Button fx:id="btnReiniciarClientes" text="Reiniciar" onAction="#reiniciarClientes"/>
        </HBox>
    </VBox>

    <!-- SECCIÓN DE PRODUCTOS (50 registros) -->
    <VBox spacing="8" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 12;">
        <Label text="Proceso de Productos (50 registros)" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
        <Label fx:id="lblEstadoProductos" text="Esperando inicio"/>
        <ProgressBar fx:id="barraProductos" progress="0" prefWidth="520"/>
        <Label fx:id="lblPorcentajeProductos" text="0%"/>
        <HBox alignment="CENTER" spacing="10">
            <Button fx:id="btnIniciarProductos" text="Iniciar Productos" onAction="#iniciarProductos"/>
            <Button fx:id="btnDetenerProductos" text="Detener" onAction="#detenerProductos" disable="true"/>
            <Button fx:id="btnReiniciarProductos" text="Reiniciar" onAction="#reiniciarProductos"/>
        </HBox>
    </VBox>
</VBox>